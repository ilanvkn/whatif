      "binDirectory": "/REVIEWED/POSTGRES/bin"
    },
    "workers": 0,
    "reset": "seed-copy-per-confirmation",
    "restartCampaign": {
      "schemaVersion": 1,
      "question": "RealWorld favorites and content persist across PG server restart",
      "target": "http://127.0.0.1:8080/",
      "budget": {
        "maxRequests": 3,
        "maxDurationMs": 60000
      },
      "branches": [
        {
          "id": "read-after-restart",
          "engine": "api",
          "hypothesis": "Read the committed retained article after process restart",
          "config": {
            "maxRequests": 1,
            "timeoutMs": 5000,
            "allowRequests": [
              {
                "method": "GET",
                "path": "/api/articles/persistent-healthy-article"
              }
            ],
            "steps": [
              {
                "method": "GET",
                "path": "/api/articles/persistent-healthy-article",
                "expectStatus": [
                  200
                ],
                "assert": [
                  {
                    "pointer": "/article/body",
                    "equals": "Preserve this record"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "favorite-persistence",
          "engine": "api",
          "hypothesis": "favorite persistence",
          "config": {
            "maxRequests": 2,
            "timeoutMs": 5000,
            "allowRequests": [
              {
                "method": "POST",
                "path": "/api/users/login"
              },
              {
                "method": "GET",
                "path": "/api/articles/concurrent-article-c"
              }
            ],
            "steps": [
              {
                "method": "POST",
                "path": "/api/users/login",
                "expectStatus": [
                  200
                ],
                "json": {
                  "user": {
