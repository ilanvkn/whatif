                "path": "/api/articles/concurrent-article-c",
                "expectStatus": [
                  200
                ],
                "headers": {
                  "Authorization": "Token {{owner}}"
                },
                "assert": [
                  {
                    "pointer": "/article/favoritesCount",
                    "equals": 1
                  },
                  {
                    "pointer": "/article/favorited",
                    "equals": true
                  }
                ]
              }
            ]
          }
        }
      ]
    }
