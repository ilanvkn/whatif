    "repository": "https://github.com/miguelgrinberg/microblog-api",
    "commit": "e250d7115b47010ff0e7051d5868485fff4e32fb",
    "license": "MIT",
    "sourceBasis": "Exact upstream source plus immutable local SQLite bootstrap; real authentication enabled"
  },
  "contract": "Fix the natural pagination validation defect: nonpositive limit values must return400 consistently in offset and keyset after/before cursor modes, before querying. Preserve valid positive limits and the configured maximum25, healthy authentication, author-only updates/deletes and allowed reads by other authenticated users. Do not change auth, bootstrap, tests, dependencies or error oracles. The fixed cursor may use different timestamp or ID types; preserve existing supported paths. Each confirmation restores exact empty SQLite seed; records must persist across a real process restart.",
  "backend": {
    "python": "/REPLACE_WITH_REVIEWED_VENV/bin/python",
    "reset": "seed-copy-per-confirmation",
    "restartCampaign": {
      "schemaVersion": 1,
      "question": "Authenticated committed records survive server restart",
      "target": "http://127.0.0.1:8080/",
      "budget": {
        "maxRequests": 2,
        "maxDurationMs": 60000
      },
      "branches": [
        {
          "id": "read-after-restart",
          "engine": "api",
          "hypothesis": "Login and read committed posts after process restart",
          "config": {
            "maxRequests": 2,
            "timeoutMs": 5000,
            "allowRequests": [
              {
                "method": "POST",
                "path": "/api/tokens"
              },
              {
                "method": "GET",
                "path": "/api/posts"
              }
            ],
            "steps": [
              {
                "method": "POST",
                "path": "/api/tokens",
                "expectStatus": [
                  200
                ],
                "headers": {
                  "Authorization": "Basic aGVhbHRoeS1hbGljZTpzeW50aGV0aWMtcGFzc3dvcmQ="
                },
                "capture": {
                  "owner": "/access_token"
                }
              },
              {
                "method": "GET",
                "path": "/api/posts",
                "expectStatus": [
                  200
                ],
                "headers": {
                  "Authorization": "Bearer {{owner}}"
                },
                "query": {
                  "limit": 2
                },
                "assert": [
                  {
                    "pointer": "/data/0/text",
                    "exists": true
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
