  "contract": "Repair ordinary article DELETE error handling. Anonymous deletion must401, another authenticated owner must403 or404, and an authenticated owner deleting a nonexistent slug must404. Preserve article contents on denied requests and preserve successful owner create/read/delete. Existing failures are incorrect500 responses, not proven ownership bypass. Do not disable auth or blanket deny all deletion. Only conduit/articles/views.py editable; keep dependencies/bootstrap/models/oracles unchanged. Do not touch or invoke deliberate /security demo routes. Every confirmation restores exact SQLite seed; committed records must be read after real server restart.",
  "backend": {
    "python": "/REPLACE_WITH_REVIEWED_VENV/bin/python",
    "reset": "seed-copy-per-confirmation",
    "restartCampaign": {
      "schemaVersion": 1,
      "question": "Committed article survives process restart",
      "target": "http://127.0.0.1:8080/",
      "budget": {
        "maxRequests": 1,
        "maxDurationMs": 60000
      },
      "branches": [
        {
          "id": "read-after-restart",
          "engine": "api",
          "hypothesis": "Read the committed retained article after process restart",
          "config": {
            "maxRequests": 1,
            "timeoutMs": 5000,
            "allowRequests": [
              {
                "method": "GET",
                "path": "/api/articles/persistent-healthy-article"
              }
            ],
            "steps": [
              {
                "method": "GET",
                "path": "/api/articles/persistent-healthy-article",
                "expectStatus": [
                  200
                ],
                "assert": [
                  {
                    "pointer": "/article/body",
                    "equals": "Preserve this record"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
