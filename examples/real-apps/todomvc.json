          "steps": [
            {
              "action": "goto",
              "path": "/"
            },
            {
              "action": "fill",
              "selector": ".new-todo",
              "value": "Healthy task"
            },
            {
              "action": "click",
              "selector": "h1"
            },
            {
              "action": "text",
              "selector": ".todo-list li label",
              "expected": "Healthy task"
            },
            {
              "action": "click",
              "selector": ".todo-list .toggle"
            },
            {
              "action": "text",
              "selector": ".todo-count",
              "expected": "0 items left"
            }
          ]
        }
