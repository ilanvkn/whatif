{
  "name": "whatif-plugin",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-led application scenarios, bounded probes and load-test preparation",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "whatif": "./src/cli.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "check": "node scripts/validate-package.mjs",
    "test:engines": "WHATIF_ENGINE_TESTS=1 node --test test/engines.integration.test.mjs",
    "demo:integrations": "node scripts/integration-demo.mjs",
    "demo:lab": "node scripts/lab-demo.mjs"
  },
  "license": "MIT"
}
