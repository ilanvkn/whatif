{
  "name": "whatif-plugin",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-led browser and API testing with isolated macOS static-web, SQLite and PostgreSQL repair trials",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "whatif": "./src/cli.mjs"
  },
  "scripts": {
    "test": "node --test --test-concurrency=2 test/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "check": "node scripts/validate-package.mjs",
    "test:engines": "WHATIF_ENGINE_TESTS=1 node --test test/engines.integration.test.mjs test/browser-actions.test.mjs",
    "demo:integrations": "node scripts/integration-demo.mjs",
    "demo:lab": "node scripts/lab-demo.mjs"
  },
  "license": "MIT",
  "exports": "./src/index.mjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/ilanvkn/whatif.git"
  }
}
